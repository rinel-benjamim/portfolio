---
const skillCategories = [
  {
    category: 'Backend & FullStack',
    skills: ['Node.js', 'Python', 'TypeScript', 'PostgreSQL', 'MongoDB', 'Docker', 'AWS/GCP', 'Microserviços'],
  },
  {
    category: 'Frontend',
    skills: ['React', 'Vue.js', 'Next.js', 'Tailwind CSS', 'GraphQL', 'REST APIs', 'WebSockets', 'Performance'],
  },
  {
    category: 'AI & Automação',
    skills: ['LLMs/OpenAI', 'Langchain', 'RAG', 'Agentes IA', 'NLP', 'Automação RPA', 'Computer Vision', 'Prompt Engineering'],
  },
  {
    category: 'Product & Gestão',
    skills: ['Product Strategy', 'Roadmap Planning', 'User Research', 'Data Analysis', 'OKRs', 'Scrum/Agile', 'Stakeholder Mgmt', 'Go-to-Market'],
  },
];
---
<section id="skills" class="w-full px-6 md:px-16 py-16 md:py-20 bg-muted font-body">
  <div class="mb-12" data-animate="fade-up">
    <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-3">Expertise</p>
    <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(28px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
      Skills & Tecnologias
    </h2>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" data-stagger>
    {skillCategories.map((cat) => (
      <div class="bg-card border border-border rounded-lg p-6 flex flex-col gap-4 hover:shadow-md transition-shadow duration-300">
        <h3 class="font-headings font-bold text-base text-foreground">{cat.category}</h3>
        <div class="flex flex-wrap gap-2">
          {cat.skills.map((skill) => (
            <span class="text-xs font-medium bg-muted px-2.5 py-1.5 rounded-md text-muted-foreground border border-border">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
