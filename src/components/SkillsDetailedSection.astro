---
const skillCategories = [
  {
    category: 'Frontend & Mobile',
    skills: ['React', 'Next.js', 'Vue.js', 'React Native', 'AstroJS', 'TypeScript', 'Tailwind CSS', 'Bootstrap', 'Livewire', 'Blade'],
  },
  {
    category: 'Backend',
    skills: ['PHP/Laravel', 'Java', 'Node.js', 'C#', 'REST APIs'],
  },
  {
    category: 'Banco de Dados',
    skills: ['PostgreSQL', 'MySQL', 'SQLite', 'SQL Server', 'Redis'],
  },
  {
    category: 'DevOps & IA',
    skills: ['Docker', 'GitHub Actions', 'Linux (VPS)', 'OpenCode', 'Claude Code', 'GitHub Copilot'],
  },
];
---
<section id="skills" class="w-full px-5 md:px-16 py-12 md:py-20 bg-muted font-body">
  <div class="mb-8 md:mb-12" data-animate="fade-up">
    <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-3">Expertise</p>
    <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(24px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
      Skills & Tecnologias
    </h2>
  </div>
  <div class="flex flex-col md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6" data-stagger>
    {skillCategories.map((cat) => (
      <div class="bg-card border border-border rounded-lg p-5 md:p-6 flex flex-col gap-3 md:gap-4 hover:shadow-md transition-shadow duration-300">
        <h3 class="font-headings font-bold text-sm md:text-base text-foreground">{cat.category}</h3>
        <div class="flex flex-wrap gap-2">
          {cat.skills.map((skill) => (
            <span class="text-xs font-medium bg-muted px-2.5 py-1.5 rounded-md text-muted-foreground border border-border">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
