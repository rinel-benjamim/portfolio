---
const articles = [
  {
    title: 'Como construir ERPs escaláveis em 2024',
    excerpt: 'Uma deep dive em arquitetura de sistemas ERP modernos, padrões de design e otimizações de performance que suportam centenas de clientes simultaneamente.',
    date: '25 de Novembro, 2024',
    readTime: '12 min',
    category: 'Architecture',
  },
  {
    title: 'O futuro do Product Management em tempos de IA',
    excerpt: 'Reflexões sobre como agentes de IA estão transformando a forma como pensamos sobre desenvolvimento de produtos, roadmaps e ciclos de feedback.',
    date: '18 de Novembro, 2024',
    readTime: '8 min',
    category: 'Product Strategy',
  },
  {
    title: 'Building High-Performance Teams: Lessons from 5 years leading engineers',
    excerpt: 'O que aprendi liderando equipes técnicas através de diferentes fases de crescimento — culture, hiring, feedback loops e career development.',
    date: '10 de Novembro, 2024',
    readTime: '15 min',
    category: 'Leadership',
  },
];
---
<section class="w-full px-6 md:px-16 py-16 md:py-20 bg-muted font-body">
  <div class="mb-12" data-animate="fade-up">
    <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-3">Pensamentos</p>
    <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(28px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
      Artigos & Insights
    </h2>
  </div>
  <div class="space-y-5 max-w-4xl" data-stagger>
    {articles.map((art) => (
      <a class="bg-card border border-border rounded-lg p-6 flex items-start gap-6 group hover:shadow-md transition-shadow duration-300 cursor-pointer">
        <!-- Left: category badge -->
        <div class="flex-shrink-0 pt-1">
          <span class="text-xs font-semibold uppercase px-3 py-1.5 rounded-md bg-secondary text-secondary-foreground">
            {art.category}
          </span>
        </div>
        <!-- Center: content -->
        <div class="flex flex-col gap-2 flex-1">
          <h3 class="font-headings font-bold text-lg text-foreground leading-tight">{art.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{art.excerpt}</p>
          <div class="flex items-center gap-4 pt-2 text-xs text-muted-foreground">
            <span>{art.date}</span>
            <span>&#8226;</span>
            <span>{art.readTime} leitura</span>
          </div>
        </div>
        <!-- Right: arrow -->
        <div class="flex-shrink-0 pt-1">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
      </a>
    ))}
  </div>
</section>
