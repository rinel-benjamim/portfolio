<section class="w-full px-5 md:px-16 py-12 md:py-20 bg-muted font-body">
  <div class="mb-8 md:mb-12" data-animate="fade-up">
    <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-3">Pensamentos</p>
    <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(24px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
      Artigos & Insights
    </h2>
  </div>
  <div class="flex flex-col gap-5 max-w-4xl" data-stagger>
    {articles.map((art) => (
      <a href={art.url} target="_blank" class="bg-card border border-border rounded-lg p-5 md:p-6 flex flex-col md:flex-row md:items-start gap-3 md:gap-6 group hover:shadow-md transition-shadow duration-300 cursor-pointer">
        <span class="text-xs font-semibold uppercase px-3 py-1.5 rounded-md bg-secondary text-secondary-foreground self-start flex-shrink-0 pt-1">
          {art.category}
        </span>
        <div class="flex flex-col gap-2 flex-1">
          <h3 class="font-headings font-bold text-sm md:text-lg text-foreground leading-tight">{art.title}</h3>
          <div class="flex items-center gap-4 pt-2 text-xs text-muted-foreground">
            <span>{art.date}</span>
            <span>&#8226;</span>
            <span>{art.readTime} leitura</span>
          </div>
        </div>
        <div class="flex-shrink-0 pt-1 hidden md:block">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
      </a>
    ))}
  </div>
</section>
