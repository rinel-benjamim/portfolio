---
const articles = [
  {
    title: 'Como construir ERPs escaláveis em 2024',
    date: '25 Nov, 2024',
    readTime: '12 min',
    category: 'Architecture',
  },
  {
    title: 'O futuro do Product Management em tempos de IA',
    date: '18 Nov, 2024',
    readTime: '8 min',
    category: 'Product Strategy',
  },
  {
    title: 'Building High-Performance Teams: 5 years of lessons',
    date: '10 Nov, 2024',
    readTime: '15 min',
    category: 'Leadership',
  },
];
---
<section class="w-full px-5 md:px-16 py-12 md:py-20 bg-muted font-body">
  <div class="mb-8 md:mb-12" data-animate="fade-up">
    <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-2">Pensamentos</p>
    <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(24px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
      Artigos & Insights
    </h2>
  </div>
  <div class="flex flex-col gap-4 max-w-4xl" data-stagger>
    {articles.map((art) => (
      <a class="bg-card border border-border rounded-lg p-5 flex flex-col md:flex-row md:items-center gap-3 md:gap-6 group hover:shadow-md transition-shadow duration-300 cursor-pointer">
        <span class="text-xs font-semibold uppercase px-2.5 py-1 rounded-md bg-secondary text-secondary-foreground self-start">
          {art.category}
        </span>
        <div class="flex flex-col gap-1 flex-1">
          <h3 class="font-headings font-bold text-sm md:text-lg text-foreground leading-snug">{art.title}</h3>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
              <span>{art.date}</span>
              <span>&#8226;</span>
              <span>{art.readTime} leitura</span>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground group-hover:translate-x-1 transition-transform md:block hidden"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
