---
const caps = [
  {
    icon: 'settings-2',
    title: 'Full-Stack Development',
    desc: 'Desenvolvimento completo com React, Next.js, Laravel, Java e Node.js — do front-end ao back-end.',
  },
  {
    icon: 'smartphone',
    title: 'Mobile Development',
    desc: 'Aplicações móveis com React Native e integração com APIs REST para soluções multiplataforma.',
  },
  {
    icon: 'server',
    title: 'DevOps & Infraestrutura',
    desc: 'Docker, GitHub Actions, administração de servidores Linux (VPS) e CI/CD.',
  },
  {
    icon: 'kanban',
    title: 'Gestão de Projetos',
    desc: 'Comunicação com stakeholders, mitigação de riscos e liderança de equipas de desenvolvimento.',
  },
];

const iconSvgs: Record<string, string> = {
  'settings-2': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
  'smartphone': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>',
  'server': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>',
  'kanban': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>',
};
---
<section class="w-full px-5 md:px-16 py-12 md:py-20 bg-muted font-body">
  <div class="mb-8 md:mb-12" data-animate="fade-up">
    <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-2">O que faço</p>
    <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(24px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
      Capacidades de ponta a ponta
    </h2>
  </div>
  <div class="flex flex-col md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5" data-stagger>
    {caps.map((c) => (
      <div class="bg-card border border-border rounded-lg p-5 md:p-6 flex flex-row md:flex-col gap-3 md:gap-4 items-start hover:shadow-md transition-shadow duration-300">
        <div class="w-9 h-9 md:w-10 md:h-10 rounded-md bg-primary flex items-center justify-center flex-shrink-0" set:html={iconSvgs[c.icon]} />
        <div class="flex flex-col gap-1 md:gap-1.5">
          <h3 class="font-headings font-bold text-sm md:text-base text-foreground">{c.title}</h3>
          <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">{c.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>
