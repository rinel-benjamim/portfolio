---
const caps = [
  {
    icon: 'settings-2',
    title: 'Backend & FullStack',
    desc: 'Sistemas robustos com Node.js, Python, PostgreSQL e arquiteturas escaláveis em cloud.',
  },
  {
    icon: 'kanban',
    title: 'Project Management',
    desc: 'Gestão ágil de produtos e equipes com foco em entrega de valor e eficiência operacional.',
  },
  {
    icon: 'trending-up',
    title: 'Product Strategy & Growth',
    desc: 'Definição de roadmaps, análise de mercado e estratégias de crescimento orientadas a dados.',
  },
  {
    icon: 'bot',
    title: 'AI-Assisted Development',
    desc: 'Integração de LLMs, automação inteligente e agentes de IA em produtos e processos.',
  },
];

const iconSvgs: Record<string, string> = {
  'settings-2': '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
  'kanban': '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>',
  'trending-up': '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>',
  'bot': '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg>',
};
---
<section class="w-full px-6 md:px-16 py-16 md:py-20 bg-muted font-body">
  <div class="mb-12" data-animate="fade-up">
    <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-3">O que faço</p>
    <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(28px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
      Capacidades de ponta a ponta
    </h2>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" data-stagger>
    {caps.map((c) => (
      <div class="bg-card border border-border rounded-lg p-6 flex flex-col gap-4 hover:shadow-md transition-shadow duration-300">
        <div class="w-10 h-10 rounded-md bg-primary flex items-center justify-center" set:html={iconSvgs[c.icon]} />
        <h3 class="font-headings font-bold text-base text-foreground">{c.title}</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">{c.desc}</p>
      </div>
    ))}
  </div>
</section>
