---
const testimonials = [
  {
    quote: '"Rinel possui uma capacidade única de compreender objetivos de negócio complexos e traduzi-los em código limpo, estável e bem arquitetado."',
    name: 'Gabriela Mendes',
    role: 'Product Owner na TechCorp',
    avatar: '/images/avatar-1.png',
  },
  {
    quote: '"Sua liderança de escopo e visão focada em soluções ágeis foi fundamental para o lançamento bem-sucedido de nossa plataforma piloto em tempo recorde."',
    name: 'Felipe Rodrigues',
    role: 'Fundador da Venturer Co.',
    avatar: '/images/avatar-2.png',
  },
];
---
<section id="testimonials" class="py-[120px] px-20 bg-dark border-b border-dark-border">
  <div class="flex flex-col gap-16">
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <span class="text-accent font-mono font-bold text-base">08</span>
        <span class="w-6 h-[1px] bg-accent"></span>
        <span class="text-accent font-mono font-semibold text-sm uppercase">Depoimentos</span>
      </div>
      <h2 class="text-light font-semibold text-[44px] leading-[1.15em] font-[Sora]">O Que Dizem Parceiros e Clientes</h2>
    </div>
    <div class="grid grid-cols-2 gap-6">
      {testimonials.map((t) => (
        <div class="flex flex-col p-10 justify-between bg-dark-card border border-dark-border rounded-2xl">
          <p class="text-light font-[Sora] text-xl leading-[1.6em]">{t.quote}</p>
          <div class="flex items-center gap-4 pt-8 mt-8">
            <div class="w-12 h-12 rounded-full border border-accent overflow-hidden flex-shrink-0">
              <img src={t.avatar} alt={t.name} class="w-full h-full object-cover" />
            </div>
            <div class="flex flex-col gap-0.5">
              <span class="text-light font-semibold text-sm">{t.name}</span>
              <span class="text-muted font-[Sora] text-[13px]">{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
