---
const interests = [
  { text: 'Startup Ecosystem', accent: true },
  { text: 'AI Agents Engineering', accent: false },
  { text: 'Product Building', accent: false },
  { text: 'Personal Development', accent: true },
  { text: 'Business Strategy', accent: false },
  { text: 'Backend Optimization', accent: false },
  { text: 'Clean Architecture', accent: true },
  { text: 'Agile Operations', accent: false },
];
---
<section class="py-12 md:py-[100px] px-6 md:px-20 bg-dark flex flex-col items-center gap-8 md:gap-12">
  <div class="flex flex-col items-center gap-3">
    <div class="flex items-center gap-3">
      <span class="text-accent font-mono font-bold text-base">07</span>
      <span class="w-6 h-[1px] bg-accent"></span>
      <span class="text-accent font-mono font-semibold text-sm uppercase">Interesses</span>
    </div>
    <h2 class="text-light font-semibold text-3xl md:text-[44px] leading-[1.15em] font-[Sora] text-center">Além do Código</h2>
  </div>
  <div class="flex flex-wrap justify-center gap-2.5 md:gap-3 max-w-[900px]">
    {interests.map((item) => (
      <span class:list={[
        'px-3 md:px-4 py-1.5 rounded-full text-[9px] md:text-[10px] font-mono',
        item.accent
          ? 'bg-accent-bg border border-accent text-accent'
          : 'bg-dark-card border border-dark-border text-muted',
      ]}>
        {item.text}
      </span>
    ))}
  </div>
</section>
