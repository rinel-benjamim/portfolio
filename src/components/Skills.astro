---
const frontendSkills = [
  { name: 'React', level: 5 },
  { name: 'Next.js', level: 4 },
  { name: 'TypeScript', level: 4 },
  { name: 'Tailwind CSS', level: 5 },
  { name: 'HTML/CSS', level: 5 },
];

const backendRings = [
  [{ name: 'Node.js', pct: '92%' }, { name: 'Python', pct: '85%' }],
  [{ name: 'PostgreSQL', pct: '90%' }, { name: 'MongoDB', pct: '80%' }],
  [{ name: 'REST APIs', pct: '95%' }, { name: 'GraphQL', pct: '85%' }],
];

const devopsSkills = [
  { name: 'Docker', label: 'Active Containerization', pct: '85%' },
  { name: 'AWS', label: 'Cloud Native Deployments', pct: '80%' },
  { name: 'CI/CD Platforms', label: 'Automated Workflows', pct: '90%' },
  { name: 'Git & Version Control', label: 'Strict Spec Management', pct: '95%' },
  { name: 'Linux Administration', label: 'Shell Pragmatism', pct: '85%' },
];

const pmSkills = [
  { name: 'Agile / Scrum Mastery', level: 'Expert' },
  { name: 'Jira / Linear Workspaces', level: 'Advanced' },
  { name: 'Risk Mitigation & Analysis', level: 'Strict' },
  { name: 'Stakeholder Communication', level: 'Native' },
];

const strategyTags = [
  { name: 'User Research', badge: 'Feedback Loops' },
  { name: 'MVP Strategy', badge: 'Fast Prototyping' },
  { name: 'Data-Driven Decisions', badge: 'Analytics Integration' },
  { name: 'A/B Testing', badge: 'Hypothesis Testing' },
];
---
<section id="skills" class="py-[120px] px-20 bg-dark border-b border-dark-border">
  <div class="flex gap-20 self-stretch">
    <!-- Left Column -->
    <div class="w-[460px] flex-shrink-0 flex flex-col gap-12">
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="text-accent font-mono font-bold text-xs">05</span>
          <span class="w-8 h-[1px] bg-accent"></span>
          <span class="text-accent font-mono font-semibold text-sm uppercase">Competências</span>
        </div>
        <h2 class="text-light font-semibold text-[44px] leading-[1.15em] font-[Sora]">As Minhas Skills</h2>
        <p class="text-muted font-[Sora] text-base leading-[1.6em] max-w-[720px]">
          Domínio conceitual e prático de arquiteturas modernas. Uma interseção calculada entre desenvolvimento robusto de sistemas e gestão ágil de produtos.
        </p>
      </div>

      <!-- Overall Index Card -->
      <div class="flex flex-col p-8 gap-6 bg-dark-card border border-dark-border rounded-2xl">
        <div class="flex flex-col gap-1.5">
          <span class="text-accent font-mono font-semibold text-xs uppercase">Mapeamento Holístico</span>
          <span class="text-light font-semibold text-xl font-[Sora]">Índice de Especialidade</span>
        </div>
        <div class="flex items-center gap-6">
          <div class="relative w-[140px] h-[140px] flex-shrink-0">
            <!-- Outer ring -->
            <div class="absolute inset-0 rounded-full border-[12px] border-dark-border"></div>
            <div class="absolute inset-0 rounded-full border-[12px] border-accent" style="clip-path: polygon(0 0, 90% 0, 90% 100%, 0 100%);"></div>
            <!-- Inner ring -->
            <div class="absolute inset-[18px] rounded-full border-[12px] border-dark-border"></div>
            <div class="absolute inset-[18px] rounded-full border-[12px] border-light" style="clip-path: polygon(0 0, 85% 0, 85% 100%, 0 100%);"></div>
            <!-- Center text -->
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-light font-mono font-bold text-lg">90%</span>
              <span class="text-zinc-500 font-semibold text-[9px] uppercase">Geral</span>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-[2px] bg-accent"></div>
              <div class="flex flex-col">
                <span class="text-light font-semibold text-[13px]">Engineering</span>
                <span class="text-muted text-[11px]">Frontend, Backend, Cloud</span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-[2px] bg-light"></div>
              <div class="flex flex-col">
                <span class="text-light font-semibold text-[13px]">Product & PM</span>
                <span class="text-muted text-[11px]">Agile, MVP, Strategy</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column -->
    <div class="flex-1 flex flex-col gap-6">
      <!-- Frontend + Backend Row -->
      <div class="grid grid-cols-2 gap-6">
        <!-- Frontend Card -->
        <div class="flex flex-col p-8 gap-6 bg-dark-card border border-dark-border rounded-2xl">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-accent-bg">
                <img src="/images/code-xml.svg" alt="" class="w-[18px] h-[18px]" />
              </div>
              <span class="text-light font-semibold text-lg">Frontend</span>
            </div>
            <span class="text-zinc-500 font-mono text-xs">CORE</span>
          </div>
          <div class="flex flex-col gap-4">
            {frontendSkills.map((skill) => (
              <div class="flex items-center justify-between">
                <span class="text-muted font-semibold text-sm">{skill.name}</span>
                <div class="flex items-center gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <div class={`w-2 h-[1px] rounded-sm ${i < skill.level ? 'bg-accent' : 'bg-dark-border'}`}></div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Backend Card -->
        <div class="flex flex-col p-8 gap-6 bg-dark-card border border-dark-border rounded-2xl">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-accent-bg">
                <img src="/images/database.svg" alt="" class="w-[18px] h-[18px]" />
              </div>
              <span class="text-light font-semibold text-lg">Backend</span>
            </div>
            <span class="text-zinc-500 font-mono text-xs">SCALABLE</span>
          </div>
          <div class="flex flex-col gap-4">
            {backendRings.map((row) => (
              <div class="flex justify-between">
                {row.map((item) => (
                  <div class="flex items-center gap-3">
                    <div class="relative w-14 h-14 flex-shrink-0">
                      <div class="absolute inset-0 rounded-full border-[3px] border-dark-border"></div>
                      <div class="absolute inset-0 rounded-full border-[3px] border-accent" style={`clip-path: polygon(0 0, ${parseInt(item.pct)}% 0, ${parseInt(item.pct)}% 100%, 0 100%);`}></div>
                      <div class="absolute inset-0 flex items-center justify-center">
                        <span class="text-light font-mono font-bold text-[11px]">{item.pct}</span>
                      </div>
                    </div>
                    <span class="text-muted font-semibold text-sm">{item.name}</span>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- DevOps + PM Row -->
      <div class="grid grid-cols-2 gap-6">
        <!-- DevOps Card -->
        <div class="flex flex-col p-8 gap-6 bg-dark-card border border-dark-border rounded-2xl">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-accent-bg">
                <img src="/images/server.svg" alt="" class="w-[18px] h-[18px]" />
              </div>
              <span class="text-light font-semibold text-lg">DevOps & Cloud</span>
            </div>
            <span class="text-zinc-500 font-mono text-xs">PIPELINE</span>
          </div>
          <div class="flex flex-col gap-4">
            {devopsSkills.map((skill) => (
              <div class="flex items-center justify-between">
                <div class="flex flex-col gap-0.5">
                  <span class="text-light font-semibold text-sm">{skill.name}</span>
                  <span class="text-zinc-500 text-[11px]">{skill.label}</span>
                </div>
                <div class="flex flex-col items-end gap-1">
                  <div class="w-10 h-1 bg-accent rounded-sm"></div>
                  <span class="text-accent font-mono text-[10px]">{skill.pct}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- PM Card -->
        <div class="flex flex-col p-8 gap-6 bg-dark-card border border-dark-border rounded-2xl">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-accent-bg">
                <img src="/images/kanban.svg" alt="" class="w-[18px] h-[18px]" />
              </div>
              <span class="text-light font-semibold text-lg">Project Management</span>
            </div>
            <span class="text-zinc-500 font-mono text-xs">DELIVERY</span>
          </div>
          <div class="flex flex-col gap-3">
            {pmSkills.map((skill) => (
              <div class="flex items-center gap-3">
                <div class="w-5 h-5 flex items-center justify-center rounded-[10px] bg-accent-bg">
                  <img src="/images/check.svg" alt="" class="w-2.5 h-2.5" />
                </div>
                <div class="flex items-center justify-between flex-1">
                  <span class="text-muted font-semibold text-sm">{skill.name}</span>
                  <span class="bg-dark-border text-muted font-mono text-[10px] px-2 py-0.5 rounded">{skill.level}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Strategy Card -->
      <div class="flex flex-col p-8 gap-6 bg-dark-card border border-dark-border rounded-2xl">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-accent-bg">
              <img src="/images/trending-up.svg" alt="" class="w-[18px] h-[18px]" />
            </div>
            <span class="text-light font-semibold text-lg">Product & Strategy</span>
          </div>
          <span class="text-zinc-500 font-mono text-xs">METRICS-DRIVEN</span>
        </div>
        <div class="flex flex-wrap gap-4">
          {strategyTags.map((tag) => (
            <div class="flex flex-col p-5 gap-3 bg-dark border border-dark-border rounded-xl">
              <span class="text-light font-semibold text-sm">{tag.name}</span>
              <div class="flex items-center gap-1.5">
                <div class="w-1.5 h-1.5 rounded-full bg-accent"></div>
                <span class="text-muted text-[11px]">{tag.badge}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
