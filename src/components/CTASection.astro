<section id="contact" class="w-full px-5 md:px-16 py-14 md:py-24 bg-primary font-body">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between md:gap-16">
    <div class="flex flex-col gap-6 max-w-2xl" data-animate="fade-right">
      <p class="text-xs font-semibold tracking-widest uppercase text-primary-foreground opacity-50">Próximo passo</p>
      <h2 class="font-headings font-bold text-primary-foreground leading-tight" style="font-size: clamp(28px, 6vw, 52px); letter-spacing: -2px; line-height: 1.05;">
        Vamos construir algo extraordinário juntos?
      </h2>
      <p class="text-sm md:text-base text-primary-foreground opacity-70 max-w-lg leading-relaxed">
        Estou disponível para projetos freelance, consultorias e posições de liderança em produto e tecnologia.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 pt-2">
        <a class="w-full sm:w-auto bg-accent text-accent-foreground font-semibold text-sm px-6 py-3 rounded-md text-center cursor-pointer">Entrar em contato</a>
        <a class="w-full sm:w-auto border text-sm font-medium px-6 py-3 rounded-md text-center cursor-pointer" style="border-color: rgba(255,255,255,0.3); color: white; opacity: 0.8;">Ver LinkedIn</a>
      </div>
    </div>
    <div class="flex flex-col gap-5 flex-shrink-0 mt-8 md:mt-0" data-animate="fade-left">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-md flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(255,255,255,0.2);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div>
          <p class="text-xs text-primary-foreground opacity-50">Email</p>
          <p class="text-sm font-medium text-primary-foreground">rinelbenjamim@gmail.com</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-md flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(255,255,255,0.2);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div>
          <p class="text-xs text-primary-foreground opacity-50">Localização</p>
          <p class="text-sm font-medium text-primary-foreground">Luanda, Angola</p>
        </div>
      </div>
    </div>
  </div>
</section>
