---
const contactItems = [
  { icon: 'mail', label: 'Email', value: 'rinelbenjamim@gmail.com' },
  { icon: 'phone', label: 'WhatsApp', value: '+244 9XX XXX XXX' },
  { icon: 'map-pin', label: 'Localização', value: 'Luanda, Angola' },
];

const iconSvgs: Record<string, string> = {
  mail: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
  phone: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  'map-pin': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
};
---
<section id="contact" class="w-full px-6 md:px-16 py-20 md:py-24 bg-primary font-body">
  <div class="flex flex-col lg:flex-row items-start justify-between gap-12 lg:gap-16">
    <div class="flex flex-col gap-6 max-w-2xl" data-animate="fade-right">
      <p class="text-xs font-semibold tracking-widest uppercase text-primary-foreground opacity-50">Próximo passo</p>
      <h2 class="font-headings font-bold text-primary-foreground leading-tight" style="font-size: clamp(36px, 6vw, 52px); letter-spacing: -2px; line-height: 1.05;">
        Vamos construir algo extraordinário juntos?
      </h2>
      <p class="text-base text-primary-foreground opacity-70 max-w-lg leading-relaxed">
        Estou disponível para projetos freelance, consultorias e posições de liderança em produto e tecnologia.
      </p>
      <div class="flex items-center gap-4 pt-2">
        <a class="font-semibold text-sm px-6 py-3 rounded-md cursor-pointer" style="background-color: var(--color-accent); color: var(--color-accent-foreground);">Entrar em contato</a>
        <a class="border text-sm font-medium px-6 py-3 rounded-md opacity-80 border-primary-foreground/30 text-primary-foreground hover:bg-primary-foreground/10 transition-colors cursor-pointer">Ver LinkedIn</a>
      </div>
    </div>
    <div class="flex flex-col gap-5 flex-shrink-0" data-animate="fade-left">
      {contactItems.map((item) => (
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-md border flex items-center justify-center opacity-60 border-primary-foreground/20" set:html={iconSvgs[item.icon]} />
          <div>
            <p class="text-xs text-primary-foreground opacity-50">{item.label}</p>
            <p class="text-sm font-medium text-primary-foreground">{item.value}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
