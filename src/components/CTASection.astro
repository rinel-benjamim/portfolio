<section id="contact" class="w-full px-5 md:px-16 py-14 md:py-24 bg-primary font-body flex flex-col gap-6">
  <div class="flex flex-col gap-6" data-animate="fade-right">
    <p class="text-xs font-semibold tracking-widest uppercase text-primary-foreground opacity-50">Próximo passo</p>
    <h2 class="font-headings font-bold text-primary-foreground leading-tight" style="font-size: clamp(28px, 6vw, 52px); letter-spacing: -1.5px; line-height: 1.1;">
      Vamos construir algo extraordinário juntos?
    </h2>
    <p class="text-sm md:text-base text-primary-foreground leading-relaxed" style="opacity: 0.7;">
      Disponível para projetos freelance, consultorias e posições de liderança em produto e tecnologia.
    </p>
    <div class="flex flex-col gap-3">
      <a class="bg-accent text-accent-foreground font-semibold text-sm py-3 rounded-md text-center cursor-pointer">Entrar em contato</a>
      <a class="border text-sm font-medium py-3 rounded-md text-center cursor-pointer" style="border-color: rgba(255,255,255,0.3); color: white; opacity: 0.8;">Ver LinkedIn</a>
    </div>
  </div>
  <div class="flex flex-col gap-4 pt-4 border-t" style="border-color: rgba(255,255,255,0.15);" data-animate="fade-left">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-md flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(255,255,255,0.2);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </div>
      <div>
        <p class="text-xs text-primary-foreground" style="opacity: 0.5;">Email</p>
        <p class="text-sm font-medium text-primary-foreground">rinelbenjamim@gmail.com</p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-md flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(255,255,255,0.2);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div>
        <p class="text-xs text-primary-foreground" style="opacity: 0.5;">Localização</p>
        <p class="text-sm font-medium text-primary-foreground">Luanda, Angola</p>
      </div>
    </div>
  </div>
</section>
