---
---
<section id="hero" class="pt-[80px] pl-6 md:pl-20 bg-dark">
  <!-- Mobile: column layout -->
  <div class="flex flex-col md:hidden">
    <div class="flex flex-col gap-6 pb-8">
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-2">
          <span class="w-8 h-[1px] bg-accent"></span>
          <span class="text-accent font-mono font-semibold text-[11px] uppercase">STARTUP ENTHUSIAST & PRODUCT BUILDER</span>
        </div>
        <h1 class="text-light font-bold text-5xl leading-[1.05em] font-[Sora]">
          Rinel <span class="text-accent">Benjamim</span>
        </h1>
        <p class="text-muted font-mono font-medium text-sm">Fullstack Developer (Backend-leaning) · Project Manager · Product Builder</p>
      </div>
      <p class="text-muted font-[Sora] text-base leading-[1.65em]">
        I build software products from absolute zero to launch, aligning strict engineering disciplines with business-driven project management. No hype, just robust systems and human collaboration.
      </p>
      <div class="flex flex-col items-start gap-4">
        <a href="#projects" class="flex items-center gap-2.5 bg-accent text-dark font-semibold text-sm px-6 py-3.5 rounded-full hover:opacity-90 transition-opacity">
          Explorar Projetos
          <img src="/images/arrow-right.svg" alt="" class="w-3.5 h-3.5" />
        </a>
        <a href="#" class="flex items-center gap-2 bg-dark-card text-light font-semibold text-sm px-6 py-3.5 rounded-full border border-dark-muted hover:bg-dark-muted/30 transition-colors">
          <img src="/images/download.svg" alt="" class="w-3.5 h-3.5" />
          Baixar Currículo
        </a>
      </div>
    </div>
    <div class="relative w-full h-[400px] overflow-hidden">
      <div class="absolute top-12 left-8 w-[260px] h-[440px] bg-[radial-gradient(circle_at_50%_50%,rgba(245,158,11,0.12)_0%,rgba(245,158,11,0)_100%)]"></div>
      <img src="/images/hero-photo.png" alt="Rinel Benjamim" class="absolute top-0 left-0 w-full h-full object-cover object-top" />
    </div>
    <div class="flex items-center gap-4 py-6">
      <div class="flex items-center gap-2.5">
        <div class="w-[18px] h-[18px] flex items-center justify-center">
          <img src="/images/map-pin.svg" alt="" class="w-4 h-4" />
        </div>
        <span class="text-muted font-[Sora] text-xs">Disponível para Projetos Globais</span>
      </div>
      <span class="w-[1px] h-5 bg-dark-muted"></span>
      <div class="flex items-center gap-2.5">
        <a href="#" class="w-9 h-9 flex items-center justify-center rounded-full bg-dark-card border border-dark-muted hover:bg-dark-muted/30 transition-colors">
          <img src="/images/linkedin.svg" alt="LinkedIn" class="w-4 h-4" />
        </a>
        <a href="#" class="w-9 h-9 flex items-center justify-center rounded-full bg-dark-card border border-dark-muted hover:bg-dark-muted/30 transition-colors">
          <img src="/images/github.svg" alt="GitHub" class="w-4 h-4" />
        </a>
        <a href="#" class="w-9 h-9 flex items-center justify-center rounded-full bg-dark-card border border-dark-muted hover:bg-dark-muted/30 transition-colors">
          <img src="/images/twitter.svg" alt="X" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>

  <!-- Desktop: row layout -->
  <div class="hidden md:flex items-end self-stretch h-[600px]">
    <div class="flex flex-col justify-between pr-20 pb-8 w-[900px] h-full">
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2">
            <span class="w-8 h-[1px] bg-accent"></span>
            <span class="text-accent font-mono font-semibold text-[13px] uppercase">STARTUP ENTHUSIAST & PRODUCT BUILDER</span>
          </div>
          <h1 class="text-light font-bold text-[72px] leading-[1.05em] font-[Sora]">
            Rinel <span class="text-accent">Benjamim</span>
          </h1>
          <p class="text-muted font-mono font-medium text-base">Fullstack Developer (Backend-leaning) · Project Manager · Product Builder</p>
        </div>
        <p class="text-muted font-[Sora] text-lg leading-[1.65em] max-w-[640px]">
          I build software products from absolute zero to launch, aligning strict engineering disciplines with business-driven project management. No hype, just robust systems and human collaboration.
        </p>
        <div class="flex items-center gap-4">
          <a href="#projects" class="flex items-center gap-2.5 bg-accent text-dark font-semibold text-sm px-6 py-3.5 rounded-full hover:opacity-90 transition-opacity">
            Explorar Projetos
            <img src="/images/arrow-right.svg" alt="" class="w-3.5 h-3.5" />
          </a>
          <a href="#" class="flex items-center gap-2 bg-dark-card text-light font-semibold text-sm px-6 py-3.5 rounded-full border border-dark-muted hover:bg-dark-muted/30 transition-colors">
            <img src="/images/download.svg" alt="" class="w-3.5 h-3.5" />
            Baixar Currículo
          </a>
        </div>
      </div>
      <div class="flex items-center gap-5">
        <div class="flex items-center gap-2.5">
          <div class="w-[18px] h-[18px] flex items-center justify-center">
            <img src="/images/map-pin.svg" alt="" class="w-4 h-4" />
          </div>
          <span class="text-muted font-[Sora] text-sm">Disponível para Projetos Globais</span>
        </div>
        <span class="w-[1px] h-5 bg-dark-muted"></span>
        <div class="flex items-center gap-2.5">
          <a href="#" class="w-9 h-9 flex items-center justify-center rounded-full bg-dark-card border border-dark-muted hover:bg-dark-muted/30 transition-colors">
            <img src="/images/linkedin.svg" alt="LinkedIn" class="w-4 h-4" />
          </a>
          <a href="#" class="w-9 h-9 flex items-center justify-center rounded-full bg-dark-card border border-dark-muted hover:bg-dark-muted/30 transition-colors">
            <img src="/images/github.svg" alt="GitHub" class="w-4 h-4" />
          </a>
          <a href="#" class="w-9 h-9 flex items-center justify-center rounded-full bg-dark-card border border-dark-muted hover:bg-dark-muted/30 transition-colors">
            <img src="/images/twitter.svg" alt="X" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
    <div class="relative w-[380px] h-[560px] flex-shrink-0 overflow-hidden">
      <div class="absolute top-12 left-8 w-[260px] h-[440px] bg-[radial-gradient(circle_at_50%_50%,rgba(245,158,11,0.12)_0%,rgba(245,158,11,0)_100%)]"></div>
      <img src="/images/hero-photo.png" alt="Rinel Benjamim" class="absolute top-0 left-0 w-full h-full object-cover object-top" />
    </div>
  </div>
</section>
