---
<nav class="fixed top-0 left-0 right-0 z-50 h-20 flex items-center justify-between px-6 md:px-20 bg-dark border-b border-dark-border">
  <a href="#" class="flex items-center gap-2">
    <span class="text-light font-bold text-2xl font-[Sora]">R.</span>
    <span class="text-accent font-mono font-semibold text-sm uppercase tracking-wider">BENJAMIM</span>
  </a>
  <div class="hidden md:flex items-center gap-8">
    <a href="#about" class="text-muted font-semibold text-sm hover:text-light transition-colors">Quem Sou</a>
    <a href="#what-i-do" class="text-muted font-semibold text-sm hover:text-light transition-colors">O Que Faço</a>
    <a href="#skills" class="text-muted font-semibold text-sm hover:text-light transition-colors">Projetos</a>
    <a href="#experience" class="text-muted font-semibold text-sm hover:text-light transition-colors">Experiência</a>
    <a href="#contact" class="text-muted font-semibold text-sm hover:text-light transition-colors">Contato</a>
    <a href="#contact" class="bg-accent text-dark font-semibold text-[13px] px-5 py-2.5 rounded-full hover:opacity-90 transition-opacity">Vamos Conversar</a>
  </div>
  <button id="menu-toggle" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Menu">
    <span class="w-6 h-0.5 bg-light transition-all" id="bar1"></span>
    <span class="w-6 h-0.5 bg-light transition-all" id="bar2"></span>
    <span class="w-4 h-0.5 bg-light transition-all" id="bar3"></span>
  </button>
</nav>
<div id="mobile-menu" class="fixed inset-0 z-40 bg-dark/95 backdrop-blur-sm hidden flex-col items-center justify-center gap-8 md:hidden">
  <a href="#about" class="text-muted font-semibold text-lg hover:text-light transition-colors mobile-link">Quem Sou</a>
  <a href="#what-i-do" class="text-muted font-semibold text-lg hover:text-light transition-colors mobile-link">O Que Faço</a>
  <a href="#skills" class="text-muted font-semibold text-lg hover:text-light transition-colors mobile-link">Projetos</a>
  <a href="#experience" class="text-muted font-semibold text-lg hover:text-light transition-colors mobile-link">Experiência</a>
  <a href="#contact" class="text-muted font-semibold text-lg hover:text-light transition-colors mobile-link">Contato</a>
  <a href="#contact" class="bg-accent text-dark font-semibold text-sm px-6 py-3 rounded-full hover:opacity-90 transition-opacity mobile-link">Vamos Conversar</a>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');
  const links = document.querySelectorAll('.mobile-link');
  let open = false;

  toggle?.addEventListener('click', () => {
    open = !open;
    if (open) {
      menu?.classList.remove('hidden');
      menu?.classList.add('flex');
      bar1?.classList.add('rotate-45', 'translate-y-2');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-rotate-45', '-translate-y-1', 'w-6');
    } else {
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      bar1?.classList.remove('rotate-45', 'translate-y-2');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-1', 'w-6');
    }
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      open = false;
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      bar1?.classList.remove('rotate-45', 'translate-y-2');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-1', 'w-6');
    });
  });
</script>
