---
---
<nav class="fixed top-0 left-0 right-0 z-50 w-full flex items-center justify-between px-16 py-6 bg-background border-b border-border transition-all duration-300">
  <span class="font-headings font-bold text-base tracking-tight text-foreground">RB<span class="text-accent-foreground px-1 rounded-sm" style="background-color: var(--color-accent);">.</span></span>
  <div class="hidden md:flex items-center gap-10">
    <a href="#hero" class="text-sm text-muted-foreground font-medium hover:text-foreground transition-colors">Início</a>
    <a href="#experience" class="text-sm text-muted-foreground font-medium hover:text-foreground transition-colors">Experiência</a>
    <a href="#projects" class="text-sm text-muted-foreground font-medium hover:text-foreground transition-colors">Projetos</a>
    <a href="#skills" class="text-sm text-muted-foreground font-medium hover:text-foreground transition-colors">Skills</a>
    <a href="#contact" class="text-sm text-muted-foreground font-medium hover:text-foreground transition-colors">Contato</a>
  </div>
  <a href="#contact" class="bg-primary text-primary-foreground text-sm font-medium px-5 py-2.5 rounded-md hover:opacity-90 transition-opacity">Falar comigo</a>
  <button id="menu-toggle" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Menu">
    <span class="w-6 h-0.5 bg-foreground transition-all" id="bar1"></span>
    <span class="w-6 h-0.5 bg-foreground transition-all" id="bar2"></span>
    <span class="w-4 h-0.5 bg-foreground transition-all" id="bar3"></span>
  </button>
</nav>
<div id="mobile-menu" class="fixed inset-0 z-40 bg-background/95 backdrop-blur-sm hidden flex-col items-center justify-center gap-8 md:hidden">
  <a href="#hero" class="text-muted-foreground font-semibold text-lg hover:text-foreground transition-colors mobile-link">Início</a>
  <a href="#experience" class="text-muted-foreground font-semibold text-lg hover:text-foreground transition-colors mobile-link">Experiência</a>
  <a href="#projects" class="text-muted-foreground font-semibold text-lg hover:text-foreground transition-colors mobile-link">Projetos</a>
  <a href="#skills" class="text-muted-foreground font-semibold text-lg hover:text-foreground transition-colors mobile-link">Skills</a>
  <a href="#contact" class="text-muted-foreground font-semibold text-lg hover:text-foreground transition-colors mobile-link">Contato</a>
  <a href="#contact" class="bg-primary text-primary-foreground font-semibold text-sm px-6 py-3 rounded-md hover:opacity-90 transition-opacity mobile-link">Falar comigo</a>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');
  const links = document.querySelectorAll('.mobile-link');
  let open = false;

  toggle?.addEventListener('click', () => {
    open = !open;
    if (open) {
      menu?.classList.remove('hidden');
      menu?.classList.add('flex');
      bar1?.classList.add('rotate-45', 'translate-y-2');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-rotate-45', '-translate-y-1', 'w-6');
    } else {
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      bar1?.classList.remove('rotate-45', 'translate-y-2');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-1', 'w-6');
    }
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      open = false;
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      bar1?.classList.remove('rotate-45', 'translate-y-2');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-1', 'w-6');
    });
  });
</script>
