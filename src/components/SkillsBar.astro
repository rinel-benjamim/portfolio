---
const skills = [
  'React', 'Node.js', 'Python', 'PostgreSQL', 'AI/LLM',
  'Product Strategy', 'Scrum', 'AWS', 'TypeScript', 'Docker',
];
---
<div class="w-full border-y border-border bg-muted py-3 md:py-4 px-5 md:px-16 flex items-center overflow-hidden">
  <div class="flex items-center gap-6 md:gap-10 skills-scroll">
    {[...skills, ...skills].map((s, i) => (
      <span key={i} class="text-xs md:text-sm font-medium text-muted-foreground whitespace-nowrap flex items-center gap-1.5 md:gap-2">
        <span style="color: #aaa;">&#10022;</span> {s}
      </span>
    ))}
  </div>
</div>
