---
const projects = [
  {
    image: '/images/project-1.png',
    tag: 'ERP',
    year: '2023',
    title: 'Apolo Enterprise ERP',
    description: 'Sistema ERP completo com módulos financeiros, RH, logística e BI integrado.',
    status: 'Entregue',
  },
  {
    image: '/images/project-2.png',
    tag: 'SaaS',
    year: '2024',
    title: 'Portal do Freelancer "Yallah"',
    description: 'Marketplace conectando freelancers e clientes no mercado africano com pagamentos integrados.',
    status: 'Lançado',
  },
  {
    image: '/images/project-3.png',
    tag: 'AI',
    year: '2024',
    title: 'Au-to AI Agent Orquestrador',
    description: 'Orquestrador de agentes de IA para automação de processos empresariais com LLMs.',
    status: 'Em produção',
  },
];
---
<section id="projects" class="w-full px-5 md:px-16 py-12 md:py-20 bg-background font-body">
  <div class="flex items-end justify-between mb-8 md:mb-12 gap-4" data-animate="fade-up">
    <div>
      <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-2">Portfólio</p>
      <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(24px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
        Projetos Recentes
      </h2>
    </div>
    <a class="text-xs md:text-sm font-medium text-muted-foreground border border-border px-3 md:px-4 py-2 rounded-md flex items-center gap-2 hover:bg-muted transition-colors cursor-pointer">
      Ver todos
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
  <div class="flex flex-col md:grid md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6" data-stagger>
    {projects.map((p) => (
      <div class="bg-card border border-border rounded-lg overflow-hidden flex flex-col hover:shadow-md transition-shadow duration-300">
        <!-- Mobile: image with overlay tags -->
        <div class="relative h-40 md:h-[200px] overflow-hidden">
          <img src={p.image} alt={p.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          <div class="absolute top-3 left-3">
            <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-accent text-accent-foreground">{p.tag}</span>
          </div>
          <div class="absolute top-3 right-3">
            <span class="text-xs font-medium px-2.5 py-1 rounded-md bg-card border border-border text-muted-foreground">{p.status}</span>
          </div>
        </div>
        <div class="flex flex-col gap-2 p-4 flex-1">
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-headings font-bold text-base md:text-lg text-foreground leading-tight">{p.title}</h3>
            <span class="text-xs text-muted-foreground whitespace-nowrap">{p.year}</span>
          </div>
          <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">{p.description}</p>
          <a class="flex items-center gap-1 text-xs font-medium text-foreground pt-1 cursor-pointer">
            Ver projeto
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
