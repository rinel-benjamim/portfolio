---
const projects = [
  {
    image: '/images/project-1.png',
    tag: 'ERP',
    year: '2023',
    title: 'Apolo Enterprise ERP',
    description: 'Sistema ERP completo para gestão empresarial com módulos financeiros, RH, logística e BI integrado.',
    status: 'Entregue',
  },
  {
    image: '/images/project-2.png',
    tag: 'SaaS',
    year: '2024',
    title: 'Portal do Freelancer "Yallah"',
    description: 'Plataforma marketplace conectando freelancers e clientes no mercado africano com pagamentos integrados.',
    status: 'Lançado',
  },
  {
    image: '/images/project-3.png',
    tag: 'AI',
    year: '2024',
    title: 'Au-to AI Agent Orquestrador',
    description: 'Orquestrador de agentes de IA para automação de processos empresariais com LLMs e ferramentas externas.',
    status: 'Em produção',
  },
];
---
<section id="projects" class="w-full px-6 md:px-16 py-16 md:py-20 bg-background font-body">
  <div class="flex flex-col md:flex-row items-start md:items-end justify-between mb-12 gap-4" data-animate="fade-up">
    <div>
      <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-3">Portfólio</p>
      <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(28px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
        Projetos Recentes
      </h2>
    </div>
    <a class="text-sm font-medium text-muted-foreground border border-border px-4 py-2 rounded-md flex items-center gap-2 hover:bg-muted transition-colors cursor-pointer">
      Ver todos
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-stagger>
    {projects.map((p) => (
      <div class="bg-card border border-border rounded-lg overflow-hidden flex flex-col hover:shadow-md transition-shadow duration-300">
        <div class="h-[180px] md:h-[200px] overflow-hidden">
          <img src={p.image} alt={p.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="flex flex-col gap-3 p-5 flex-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-accent text-accent-foreground">{p.tag}</span>
            <span class="text-xs text-muted-foreground">{p.year}</span>
          </div>
          <h3 class="font-headings font-bold text-lg text-foreground leading-tight">{p.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">{p.description}</p>
          <span class="text-xs font-medium text-muted-foreground">{p.status}</span>
        </div>
      </div>
    ))}
  </div>
</section>
