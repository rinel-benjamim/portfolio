---
const experiences = [
  {
    role: 'Desenvolvedor Full-stack',
    company: 'Freelancer',
    period: 'Mar 2026 – Atual',
    description: 'Desenvolvo aplicações móveis com React Native e APIs com Java. Realizo projetos full-stack de ponta a ponta, integrando front-end, back-end e bases de dados em diferentes tecnologias. Utilizo desenvolvimento assistido por IA com ferramentas como OpenCode, Claude Code e GitHub Copilot.',
    highlights: ['React Native', 'Java', 'IA Assistida', 'Full-Stack'],
  },
  {
    role: 'Desenvolvedor Full-stack',
    company: '100 Destinos',
    period: 'Set 2025 – Mar 2026',
    description: 'Desenvolvi e mantive a plataforma 100 Destinos, startup vencedora do Unitel Go Challenge, utilizando Next.js e PostgreSQL. Realizei a identificação e correção regular de bugs na plataforma.',
    highlights: ['Next.js', 'PostgreSQL', 'Startup', 'Bug Fixing'],
  },
  {
    role: 'Gestor de Projetos / Full-stack',
    company: 'Njila',
    period: 'Mai 2025 – Ago 2025',
    description: 'Geri a comunicação com stakeholders e alinhei expectativas ao longo dos projetos. Mantive e evoluí a plataforma com novas funcionalidades no back-end em Laravel e C#, e implementei interfaces com React, Vue.js e React Native.',
    highlights: ['Laravel', 'C#', 'React', 'Gestão de Projetos'],
  },
  {
    role: 'Desenvolvedor Backend',
    company: 'Ovonne',
    period: 'Jan 2025 – Mar 2025',
    description: 'Desenvolvi APIs REST e implementei soluções de back-end voltadas às necessidades do negócio. Resolvi problemas técnicos de forma proativa e apoiei a continuidade do ambiente de desenvolvimento.',
    highlights: ['REST APIs', 'Git', 'Backend'],
  },
];
---
<section id="experience" class="w-full px-5 md:px-16 py-12 md:py-20 bg-background font-body">
  <div class="mb-8 md:mb-12" data-animate="fade-up">
    <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-3">Trajetória</p>
    <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(24px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
      Experiência Profissional
    </h2>
  </div>
  <div class="flex flex-col gap-5 md:gap-6 max-w-4xl" data-stagger>
    {experiences.map((exp, i) => (
      <div class="flex gap-4 md:gap-6 pb-5 md:pb-6 border-b border-border last:border-b-0 last:pb-0">
        <div class="flex flex-col items-center flex-shrink-0 pt-1.5">
          <div class="w-3 md:w-4 h-3 md:h-4 rounded-full bg-primary border-4 border-background"></div>
          {i < experiences.length - 1 && <div class="w-px flex-1 bg-border mt-2" style="min-height: 40px;"></div>}
        </div>
        <div class="flex flex-col gap-2 md:gap-3 flex-1">
          <div class="flex items-start justify-between gap-2 md:gap-4">
            <div>
              <h3 class="font-headings font-bold text-sm md:text-lg text-foreground leading-tight">{exp.role}</h3>
              <p class="text-xs md:text-sm text-muted-foreground font-medium">{exp.company}</p>
            </div>
            <span class="text-xs font-semibold text-muted-foreground whitespace-nowrap bg-muted px-2 md:px-3 py-1 rounded-md">{exp.period}</span>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">{exp.description}</p>
          <div class="flex flex-wrap gap-2 pt-1">
            {exp.highlights.map((h) => (
              <span class="text-xs font-medium bg-accent text-accent-foreground px-2.5 py-1 rounded-md">{h}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
