---
const experiences = [
  {
    role: 'Tech Lead & Product Manager',
    company: 'Grupo Apolo',
    period: '2022 – Presente',
    description: 'Lidero equipe de 8 engineers na construção de ERP enterprise. Resultado: +300% ROI, 50+ clientes corporativos.',
    highlights: ['ERP Full Stack', 'Team Leadership', 'Product Strategy'],
  },
  {
    role: 'Senior Software Engineer',
    company: 'TechAngola',
    period: '2020 – 2022',
    description: 'Arquiteto de plataforma SaaS. Implementei microserviços e escalei sistema para 10k+ usuários simultâneos.',
    highlights: ['Microserviços', 'DevOps', 'Performance'],
  },
  {
    role: 'Full Stack Developer',
    company: 'StartupXYZ',
    period: '2019 – 2020',
    description: 'Desenvolvedor core em plataforma de e-commerce com integração de gateways de pagamento.',
    highlights: ['React', 'Node.js', 'Payment APIs'],
  },
];
---
<section id="experience" class="w-full px-5 md:px-16 py-12 md:py-20 bg-background font-body">
  <div class="mb-8 md:mb-12" data-animate="fade-up">
    <p class="text-xs font-semibold text-muted-foreground tracking-widest uppercase mb-2">Trajetória</p>
    <h2 class="font-headings font-bold text-foreground" style="font-size: clamp(24px, 5vw, 40px); letter-spacing: -1.5px; line-height: 1.1;">
      Experiência Profissional
    </h2>
  </div>
  <div class="flex flex-col gap-5 max-w-4xl" data-stagger>
    {experiences.map((exp, i) => (
      <div class="flex gap-4 pb-5 border-b border-border last:border-b-0 last:pb-0">
        <!-- Timeline dot -->
        <div class="flex flex-col items-center flex-shrink-0 pt-1.5">
          <div class="w-3 h-3 rounded-full bg-primary border-4 border-background"></div>
          {i < experiences.length - 1 && <div class="w-px flex-1 bg-border mt-2" style="min-height: 40px;"></div>}
        </div>
        <!-- Content -->
        <div class="flex flex-col gap-2 flex-1">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h3 class="font-headings font-bold text-sm md:text-lg text-foreground leading-tight">{exp.role}</h3>
              <p class="text-xs md:text-sm text-muted-foreground font-medium">{exp.company}</p>
            </div>
            <span class="text-xs font-semibold text-muted-foreground whitespace-nowrap bg-muted px-2 md:px-3 py-1 rounded-md">{exp.period}</span>
          </div>
          <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">{exp.description}</p>
          <div class="flex flex-wrap gap-1.5 md:gap-2 pt-1">
            {exp.highlights.map((h) => (
              <span class="text-xs font-medium px-2 py-0.5 md:px-2.5 md:py-1 rounded-md text-accent-foreground" style="background-color: var(--color-accent);">{h}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
